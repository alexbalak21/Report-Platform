# Copy to .env and change every "change-me" value.
POSTGRES_DB=reportplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Password shared by the per-service DB roles (rp_gateway, rp_ingestion, ...)
RP_DB_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0

# Internal service-to-service auth + JWT signing
SERVICE_TOKEN=change-me
JWT_SECRET=change-me

LOG_LEVEL=INFO

# First admin account, created by the gateway on first start when the users table is empty.
# Change the password right after the first login, then you may blank these two lines.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Set to true once the app is served over HTTPS (refresh cookie gets the Secure flag).
COOKIE_SECURE=false

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ingestion
